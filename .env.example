# Set these on the hosting platform (Render → your service → Environment).
# Never commit real values.

# Neon connection string (Neon console → Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# Random string, at least 32 characters, used to sign login tokens
JWT_SECRET=

# The admin (main user). Applied on every start: changing the password here changes it in the app.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# "true" lets new main users sign up from the app; anything else keeps the admin as the only main user
ALLOW_MAIN_SIGNUP=false
